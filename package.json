{
  "name": "realm-ag-marketplace",
  "version": "1.0.0",
  "description": "REALM Agricultural Marketplace - Fodder, Grain, Hay trading platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "psql $DATABASE_URL -f supabase/migrations/001_initial_schema.sql && psql $DATABASE_URL -f supabase/migrations/002_rls_policies.sql",
    "db:migrate:rollback": "psql $DATABASE_URL -f supabase/migrations/002_rls_policies_rollback.sql && psql $DATABASE_URL -f supabase/migrations/001_initial_schema_rollback.sql",
    "db:seed": "psql $DATABASE_URL -f supabase/seed.sql",
    "db:reset": "npm run db:migrate:rollback && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "stripe": "^14.5.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

