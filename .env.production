# ─────────────────────────────────────────────────────────────────────────────
# REALM Ag Marketplace — Production Environment Variables
#
# Copy this file to .env and fill in all required values before deploying.
# Never commit .env to version control.
#
# On Railway: set these in the service's Variables tab.
# Required variables are marked with [REQUIRED].
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────

# [REQUIRED] Runtime environment
NODE_ENV=production

# [REQUIRED] Port the Express server listens on
# Railway sets this automatically — do not override unless you know what you're doing
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string
# On Railway: automatically injected when you link a Postgres service
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/realm_ag

# ── Authentication ────────────────────────────────────────────────────────────

# [REQUIRED] Secret key for signing JWT tokens
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Keep this secret!
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS

# JWT token lifetime (e.g. 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# ── Stripe Payments ───────────────────────────────────────────────────────────

# [REQUIRED for payments] Stripe secret API key
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_live_... for production, sk_test_... for staging
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# [REQUIRED for webhooks] Stripe webhook signing secret
# Get from: https://dashboard.stripe.com/webhooks
# After creating a webhook endpoint pointing to: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Platform fee percentage charged on each order (default: 5)
STRIPE_PLATFORM_FEE_PERCENT=5

# ── Supabase (optional) ───────────────────────────────────────────────────────

# Supabase project URL (if using Supabase for storage or auth)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anonymous/public key (safe to expose to browser)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_ANON_KEY

# Supabase service role key (server-side only — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_SERVICE_ROLE_KEY

# ── Next.js Frontend ──────────────────────────────────────────────────────────

# Base URL of the Express API (used by the Next.js client-side code)
# In production this is typically the same domain
NEXT_PUBLIC_API_URL=https://your-app.railway.app

# Stripe publishable key (safe to expose to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# ── File Uploads ──────────────────────────────────────────────────────────────

# Local directory for file uploads (weighbridge tickets, certificates)
# On Railway with ephemeral storage, consider using Supabase Storage or S3 instead
UPLOAD_DIR=uploads

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Rate limit window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP address
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────────────────────────────────────
# NOTES:
#
# 1. DATABASE_URL is automatically set by Railway when you link a Postgres service.
#    You do not need to set it manually in Railway.
#
# 2. Generate a secure JWT_SECRET with:
#    openssl rand -base64 48
#    or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# 3. For Stripe webhooks, create an endpoint in the Stripe dashboard pointing to:
#    https://your-app.railway.app/api/webhooks/stripe
#    Events to listen for: payment_intent.succeeded, payment_intent.payment_failed,
#    charge.dispute.created, transfer.created
#
# 4. File uploads are stored locally by default. For production with multiple
#    instances or Railway's ephemeral filesystem, configure Supabase Storage or
#    AWS S3 and update the upload handlers in src/routes/weighbridge.js and
#    src/routes/feedtests.js.
# ─────────────────────────────────────────────────────────────────────────────
