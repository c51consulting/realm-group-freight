# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway auto-provides this)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins (use * for development)
CORS_ORIGIN=*

# Public URL of this service (used for Stripe redirect URLs)
APP_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here-min-32-chars
JWT_EXPIRES=7d

# ─── Stripe (escrow payments) ─────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Get from https://dashboard.stripe.com/webhooks after creating webhook endpoint
# Endpoint URL: https://your-domain.com/api/stripe/webhook
# Events to listen for:
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   payment_intent.canceled
#   transfer.created
#   account.updated
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank to use console.log in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@realm.ag
SMTP_PASS=your-smtp-password
EMAIL_FROM=REALM Ag Marketplace <noreply@realm.ag>

# ─── File uploads ─────────────────────────────────────────────────────────────
# Local path for uploaded files (weighbridge tickets, feed test certificates, POD photos)
# In production, replace with S3/Supabase Storage integration
UPLOAD_DIR=uploads/

